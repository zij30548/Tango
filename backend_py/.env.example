# 仅后台维护者配置；.env 与模型密钥不得打包进客户端。
# 复制为 backend_py/.env，由 Python 后台进程加载。
QUIET_BACKEND_HOST=127.0.0.1
QUIET_BACKEND_PORT=16382
QUIET_DB_PATH=./.data/quiet.sqlite
# 本机启动器读取 .local/mysql-v1/storage.env；旧库必须先迁移后显式切换。
QUIET_STORAGE_DRIVER=mysql
# 远程部署在服务器环境中配置实际 MySQL/Redis 地址：
# QUIET_DATABASE_URL=mysql://app:CHANGE_ME@127.0.0.1:3306/tango
# QUIET_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# QUIET_REDIS_NAMESPACE=tango:production
# QUIET_DATABASE_POOL_SIZE=10

# 按模型服务平台和地域填写兼容 API 的基础地址。
# QWEN_API_KEY 留空时只运行账号接口，不调用模型。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15

# 多模型先填配置、后显式启用；默认继续只调用上面的 Flash。
# flash_only：全部任务使用 Flash；task_split：复杂规划/研究用 Plus；
# plus_only：音乐任务四种模型步骤都用 Plus，仅供受控对照，意图路由仍用 Flash。
QWEN_MODEL_STRATEGY=flash_only
QWEN_PLUS_ENABLED=false
QWEN_PLUS_MODEL=qwen3.7-plus
# 与 Flash 使用同一规范化接口地址时，Key 留空可沿用原凭据。
# 使用另一把 Key 或其他兼容服务时，填写独立配置；密钥仅放私有 .env。
QWEN_PLUS_BASE_URL=
QWEN_PLUS_API_KEY=
# qwen3.7-plus 按思考模型处理；后台有界拼接 SSE，仅使用最终内容。
QWEN_PLUS_ENABLE_THINKING=true
QWEN_PLUS_STREAM=true
QWEN_PLUS_JSON_MODE=true
QWEN_PLUS_TIMEOUT_MS=60000
QWEN_PLUS_MAX_TOKENS=8192

# 可调整以下限额；已发起的尝试会消耗日额度，上游失败也计数。
QUIET_AI_DAILY_LIMIT=30
# 所有账号与 AI 功能共享这个每日模型调用尝试硬上限。
QUIET_AI_GLOBAL_DAILY_LIMIT=500
QUIET_AI_PER_MINUTE=5
QUIET_AI_GLOBAL_CONCURRENCY=8
# single_agent：共享研究上下文，曲库工具可并行执行，为默认策略。
# dual_agent：两个独立研究上下文；fixed：固定流程对照。
QUIET_TASK_STRATEGY=single_agent
QUIET_AUTH_PER_TEN_MINUTES=20
# 按规范化账号累计登录失败次数，跨 IP 的失败也计入。
# 临时限制窗口为 10 分钟；登录成功会清除该账号的失败计数。
QUIET_AUTH_FAILURES_PER_TEN_MINUTES=10
QUIET_SESSION_DAYS=7

# 默认使用内测准入，客户端不能选择或绕过此策略。
# invite_only 为邀请码注册，closed 为关闭注册，open 须维护者显式开启。
QUIET_REGISTRATION_MODE=invite_only
# 新注册密码要求为 15–128 个字符，旧账号仍可按兼容规则登录。
# 额度统计模型调用尝试，不按消息或歌曲计数；零额度表示不能调用 AI。
QUIET_ACCOUNT_DEFAULT_DAILY_LIMIT=30
QUIET_ACCOUNT_DEFAULT_TOTAL_LIMIT=300
# MySQL 部署使用 Redis 共享 HTTP 限流。
QUIET_REQUESTS_PER_MINUTE=240
QUIET_USER_REQUESTS_PER_MINUTE=180
QUIET_CONVERSATION_CREATES_PER_DAY=20
QUIET_HTTP_MAX_CONNECTIONS=1000

# 仅当同机 HTTPS 反向代理会覆盖 X-Real-IP 时，才可将此项设为 1。
# 其他情况下忽略转发头，避免客户端伪造来源 IP。
QUIET_TRUST_LOOPBACK_PROXY=0

# LangSmith 云端观测：探歌显式开关，默认关闭；密钥只留在后台。
# 这里只发送受控状态/计数/耗时/用量，不上传聊天、偏好、提示词、Cookie 或播放地址。
QUIET_LANGSMITH_ENABLED=0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tango-development
# 必须与账号所在区域一致；EU/APAC/AWS US 端点见 docs/LANGSMITH_TRACING.md。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 单工作区密钥通常可留空，多工作区密钥需填写目标工作区 UUID。
LANGSMITH_WORKSPACE_ID=
# 禁用 SDK 自动采集原始 LangGraph state；探歌通过受控埋点主动发送摘要。
LANGSMITH_TRACING=false
