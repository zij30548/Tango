  "capabilities": {
    "version": 1,
    "capabilities": [
      {
        "name": "music.task",
        "version": 1,
        "description": "找歌、新作核验和当前歌单修改，合并为一个音乐任务",
        "inputSchema": {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "new",
                "continue"
              ]
            },
            "taskId": {
              "type": "string",
              "description": "Server-bound for continue only"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "output": "task_preview",
        "permission": "owned_account_and_device",
        "confirmation": "adoption_before_playback",
        "timeoutMs": 15000,
        "modelBudget": "existing_task_budget",
        "dependencies": [
          "memory.propose:confirmed",
          "task.control:accepted"
        ],
        "acceptance": [
          "scene_and_releases_share_one_task",
          "new_topic_does_not_revise_old_task",
          "preview_does_not_play"
        ]
      },
      {
        "name": "memory.propose",
        "version": 1,
        "description": "提出当前账号本机偏好变更，确认后才保存",
        "inputSchema": {
          "type": "object",
          "required": [
            "operation",
            "preference"
          ],
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "set",
                "clear"
              ]
            },
            "preference": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "output": "local_confirmation",
        "permission": "current_turn_explicit_permission",
        "confirmation": "explicit_local_confirmation",
        "timeoutMs": 0,
        "modelBudget": 0,
        "dependencies": [],
        "acceptance": [
          "quoted_or_negated_command_rejected",
          "cancel_keeps_memory",
          "confirmation_is_account_scoped"
        ]
      },
      {
        "name": "task.control",
        "version": 1,
        "description": "暂停、取消、恢复或撤回当前音乐任务",
        "inputSchema": {
          "type": "object",
          "required": [
            "action",
            "taskId",
            "expectedRevision"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "pause",
                "cancel",
                "resume",
                "undo"
              ]
            },
            "taskId": {
              "type": "string"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "output": "task_state",
        "permission": "owned_task_and_revision",
